{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Chrome": {
      "properties": {
        "app": {
          "type": "string",
          "description": "app name / bundle ID / .app path as accepted by open -a (default: Google Chrome)"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "extra command line flags appended after the proxy and profile flags"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Config": {
      "properties": {
        "listen": {
          "type": "string",
          "description": "local proxy listen address (host:port)"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "logFile": {
          "type": "string",
          "description": "log file path (default: OS cache dir)"
        },
        "upstreams": {
          "additionalProperties": {
            "$ref": "#/$defs/Upstream"
          },
          "type": "object"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "type": "array"
        },
        "chrome": {
          "$ref": "#/$defs/Chrome"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "listen",
        "logLevel",
        "upstreams",
        "rules"
      ]
    },
    "Rule": {
      "properties": {
        "match": {
          "type": "string",
          "description": "exact host or *.suffix wildcard"
        },
        "upstream": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "match",
        "upstream"
      ]
    },
    "Upstream": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "socks5",
            "http",
            "direct",
            "ssh",
            "forward"
          ]
        },
        "addr": {
          "type": "string",
          "description": "host:port for socks5; fixed dial target for forward"
        },
        "url": {
          "type": "string",
          "description": "URL for http upstreams"
        },
        "dns": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "default": "local"
        },
        "auth": {
          "$ref": "#/$defs/UpstreamAuth"
        },
        "tls": {
          "$ref": "#/$defs/UpstreamTLS"
        },
        "host": {
          "type": "string",
          "description": "ssh: bastion hostname or IP"
        },
        "port": {
          "type": "integer",
          "description": "ssh: port (default 22)"
        },
        "user": {
          "type": "string",
          "description": "ssh: login user (default: current OS user)"
        },
        "keyFile": {
          "type": "string",
          "description": "ssh: private key path"
        },
        "keyFilePassphrase": {
          "type": "string",
          "description": "ssh: passphrase for an encrypted keyFile"
        },
        "identityAgent": {
          "type": "string",
          "description": "ssh: SSH_AUTH_SOCK or an agent socket path"
        },
        "hostKey": {
          "type": "string",
          "description": "ssh: pinned SHA256:... host key fingerprint; falls back to ~/.ssh/known_hosts"
        },
        "socks5Listen": {
          "type": "string",
          "description": "ssh: local SOCKS5 listen address (host:port)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "UpstreamAuth": {
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "username",
        "password"
      ]
    },
    "UpstreamTLS": {
      "properties": {
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "caFile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
